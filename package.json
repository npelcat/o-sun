{
  "name": "o-sun-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 4000",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed": "dotenv -e .env.local -- tsx src/db/seed/index.ts",
    "db:seed:test": "dotenv -e .env.test -- tsx src/db/seed/index.ts",
    "dev:test": "dotenv -e .env.test -- next dev -p 4000",
    "email": "email dev --dir emails --port 3001"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@strapi/blocks-react-renderer": "^1.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.45.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.68.0",
    "luxon": "^3.7.2",
    "markdown-to-jsx": "^9.10.4",
    "next": "^16.4.4",
    "next-auth": "^5.0.0-beta.30",
    "next-swagger-doc": "0.5.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.6",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "rehype-react": "^8.0.0",
    "resend": "^6.37.0",
    "swagger-ui-react": "^5.34.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@react-email/ui": "^6.11.6",
    "@tailwindcss/typography": "^0.5.20",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "daisyui": "^5.7.50",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
