  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@react-email/ui": "^6.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.7.28",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
